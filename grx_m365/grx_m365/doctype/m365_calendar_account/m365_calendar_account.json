{
  "doctype": "DocType",
  "name": "M365 Calendar Account",
  "module": "GRX M365",
  "custom": 0,
  "editable_grid": 1,
  "autoname": "format:M365-CAL-{#####}",
  "title_field": "calendar_name",
  "fields": [
    {
      "fieldname": "m365_account",
      "fieldtype": "Link",
      "label": "M365 Account",
      "options": "M365 Account",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1"
    },
    {
      "fieldname": "calendar_section",
      "fieldtype": "Section Break",
      "label": "Calendar"
    },
    {
      "fieldname": "calendar_id",
      "fieldtype": "Data",
      "label": "Calendar ID",
      "default": "primary"
    },
    {
      "fieldname": "calendar_name",
      "fieldtype": "Data",
      "label": "Calendar Name",
      "reqd": 1
    },
    {
    "fieldname": "target_user",
    "fieldtype": "Link",
    "label": "Target User",
    "options": "User",
    "default": "__user"
    },
    {
      "fieldname": "calendar_usage",
      "fieldtype": "Select",
      "label": "Calendar Usage",
      "options": "Personal\nShared\nTeam\nResource",
      "default": "Personal"
    },
    {
      "fieldname": "show_in_office_hub",
      "fieldtype": "Check",
      "label": "Show in Office Hub",
      "default": "1"
    },
    {
      "fieldname": "sync_section",
      "fieldtype": "Section Break",
      "label": "Sync"
    },
    {
      "fieldname": "pull_enabled",
      "fieldtype": "Check",
      "label": "Pull Enabled",
      "default": "1"
    },
    {
      "fieldname": "last_sync_at",
      "fieldtype": "Datetime",
      "label": "Last Sync At"
    },
    {
      "fieldname": "last_success_at",
      "fieldtype": "Datetime",
      "label": "Last Success At"
    },
    {
      "fieldname": "last_error",
      "fieldtype": "Small Text",
      "label": "Last Error"
    },
    {
      "fieldname": "sync_status",
      "fieldtype": "Select",
      "label": "Sync Status",
      "options": "Never Synced\nSuccess\nError\nDisabled",
      "default": "Never Synced"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}